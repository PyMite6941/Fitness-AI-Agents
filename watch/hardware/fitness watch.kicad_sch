	(text "FitnessAI Watch - ESP32-C3 SuperMini + SSD1306 + MAX30102 + MPU6050"
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "81aad9f4-60d2-57eb-800c-53a3cfd52848")
	)
	(text "Connections are made by NET LABEL: identically-named labels are one net."
		(exclude_from_sim no)
		(at 25.4 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a1d47861-ae24-5f50-8b99-406dd7fb1c56")
	)
	(text "Pin assignment is the source of truth in watch/firmware/fitness_watch/config.h."
		(exclude_from_sim no)
		(at 25.4 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "468dd1df-fb37-53b2-a0f0-89bc5e7b3e7f")
	)
	(text "Generated by generate_schematic.py - edit the netlist there, not the sheet."
		(exclude_from_sim no)
		(at 25.4 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2f291ad0-03e1-5f0d-95fe-e0dc7c4b5e0c")
	)
	(text "I2C runs at 100 kHz. Pull-ups are already on the breakout modules"
		(exclude_from_sim no)
		(at 144.78 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f30965b2-666d-5bc4-bc75-d42c5582ffcd")
	)
	(text "(~1.1k combined). Do not add more - see watch/README.md > Resistors."
		(exclude_from_sim no)
		(at 144.78 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ca4988f0-1c3d-5e4f-aafa-accb66ef7bee")
	)
	(text "POWER: the battery runs the watch unless USB-C is plugged in."
		(exclude_from_sim no)
		(at 25.4 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "22ecf843-ed7e-5a37-957e-a774bf9028c5")
	)
	(text "The SuperMini's 5V pad IS USB VBUS. USB present = 5.0V on that node; the"
		(exclude_from_sim no)
		(at 25.4 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "175d0054-1b5b-545f-b4da-59d657e130a4")
	)
	(text "battery branch can only reach 5.1V - 0.35V (D1) = 4.75V, so D1 reverse-"
		(exclude_from_sim no)
		(at 25.4 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ac5ceeea-6fdb-5c8d-8198-1de2963b6dd2")
	)
	(text "biases and the battery drops out. Unplug USB and it conducts again."
		(exclude_from_sim no)
		(at 25.4 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "af977dae-761c-5921-b202-de8858ce00aa")
	)
	(text "TP4056 IN+/IN- = the charger module's OWN USB socket. Do NOT wire them to"
		(exclude_from_sim no)
		(at 25.4 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "df163242-95c4-5b9c-8fb4-5cec46e763b0")
	)
	(text "the ESP32 5V pin: that makes a loop that charges the battery from itself"
		(exclude_from_sim no)
		(at 25.4 238.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "eedefbce-ced7-5667-a4e1-a218cdceccb6")
	)
	(text "(boost -> 5V -> charger -> cell -> boost). It never terminates. See POWER.md."
		(exclude_from_sim no)
		(at 25.4 243.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dbd65be0-f543-5e26-88f4-e09326ade435")
	)
	(text "SET THE MT3608 TO 5.1V, WITH NOTHING ON ITS OUTPUT, BEFORE WIRING IT UP."
		(exclude_from_sim no)
		(at 25.4 254 0)
		(effects
			(font
